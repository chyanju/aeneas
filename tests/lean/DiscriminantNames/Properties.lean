module
public import Aeneas
public import Discriminant
public import DiscriminantNames.DiscriminantNames
public section

open Aeneas Aeneas.Std Result

/-! The translations of `discriminant.rs` and `discriminant-names.rs` both declare an enumeration
`AlertLevel`, each with an instance of `Discriminant` generated by the `discriminant` attribute.
The instances are named after the full names of the types, so the two modules can be imported
together, and each instance gives the discriminants of its own type. -/

namespace discriminant_names

example : Discriminant discriminant.AlertLevel Isize := discriminant.AlertLevel.instDiscriminant
example : Discriminant AlertLevel Isize := AlertLevel.instDiscriminant

theorem read_discriminant_other : read_discriminant discriminant.AlertLevel.Fatal = 1#isize := by
  rfl

theorem read_discriminant_fatal : read_discriminant AlertLevel.Fatal = 2#isize := by
  rfl

end discriminant_names
